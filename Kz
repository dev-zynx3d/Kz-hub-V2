-- [[ LÓGICA DE VELOCIDADE E RANGE ]]
RunService.RenderStepped:Connect(function()
    if Configs.SpeedAtivo and LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid") then
        local humanoid = LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
        if humanoid.WalkSpeed ~= Configs.Velocidade then
            humanoid.WalkSpeed = Configs.Velocidade
        end
    end
end)

local function AplicarRange(tool)
    if Configs.RangeAtivo and tool:IsA("Tool") then
        if tool:FindFirstChild("Handle") then
            tool.ManualActivationOnly = false
        end
    end
end

LocalPlayer.CharacterAdded:Connect(function(character)
    character.ChildAdded:Connect(AplicarRange)
end)

if LocalPlayer.Character then
    LocalPlayer.Character.ChildAdded:Connect(AplicarRange)
end

