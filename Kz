-- FUNÇÃO PARA CRIAR BOTÕES
local function CriarToggle(texto, callback)
	local Button = Instance.new("TextButton")
	Button.Size = UDim2.new(0, 220, 0, 40)
	Button.BackgroundColor3 = Color3.fromRGB(30, 30, 38)
	Button.Text = texto .. " [DESATIVADO]"
	Button.TextColor3 = Color3.fromRGB(200, 200, 200)
	Button.TextTransparency = 1
	Button.Font = Enum.Font.GothamSemibold
	Button.TextSize = 13
	Button.BorderSizePixel = 0
	Button.Parent = Container

	local BtnCorner = Instance.new("UICorner")
	BtnCorner.CornerRadius = UDim.new(0, 8)
	BtnCorner.Parent = Button

	local BtnStroke = Instance.new("UIStroke")
	BtnStroke.Thickness = 1
	BtnStroke.Color = Color3.fromRGB(50, 50, 60)
	BtnStroke.Transparency = 1
	BtnStroke.Parent = Button

	local ativo = false
	Button.MouseButton1Click:Connect(function()
		ativo = not ativo
		local CorFundo = ativo and Color3.fromRGB(0, 180, 216) or Color3.fromRGB(30, 30, 38)
		local CorTexto = ativo and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(200, 200, 200)
		local CorBorda = ativo and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(50, 50, 60)
		local TextoMudanca = ativo and texto .. " [ATIVADO]" or texto .. " [DESATIVADO]"

		TweenService:Create(Button, TWEEN_INFO, {BackgroundColor3 = CorFundo, TextColor3 = CorTexto}):Play()
		TweenService:Create(BtnStroke, TWEEN_INFO, {Color = CorBorda}):Play()
		Button.Text = TextoMudanca
		
		callback(ativo)
	end)

	return Button, BtnStroke
end

-- Variáveis globais
local BotaoSpeed, BordaSpeed
local BotaoRange, BordaRange

-- Função para aplicar a velocidade
local function AplicarVelocidade()
	if LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid") then
		if Configs.SpeedAtivo then
			LocalPlayer.Character:FindFirstChildOfClass("Humanoid").WalkSpeed = Configs.Velocidade
		else
			LocalPlayer.Character:FindFirstChildOfClass("Humanoid").WalkSpeed = 16
		end
	end
end

-- Função para aplicar o Range
local function AplicarRange()
	if not Configs.RangeAtivo then return end
	
	task.spawn(function()
		for _, obj in ipairs(workspace:GetDescendants()) do
			if obj:IsA("ClickDetector") then
				obj.MaxActivationDistance = Configs.RangeDistancia
			end
		end
	end)
end

-- Criar os Toggles de Ativação
BotaoSpeed, BordaSpeed = CriarToggle("Super Velocidade", function(estado) 
	Configs.SpeedAtivo = estado 
	AplicarVelocidade()
end)

BotaoRange, BordaRange = CriarToggle("Aumento de Range", function(estado) 
	Configs.RangeAtivo = estado 
	if estado then AplicarRange() end
end)

